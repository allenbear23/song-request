function isValidYouTube(url){ return url.includes("youtube.com/watch?v=")||url.includes("youtu.be/"); }

function sendRequest(){
  const url=document.getElementById("urlInput").value.trim();
  const msgDiv=document.getElementById("msg");

  if(!isValidYouTube(url)){ msgDiv.innerText="❌ 請輸入有效的 YouTube 連結"; return; }

  fetch("/request",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({url})})
    .then(res=>res.json())
    .then(data=>{
      if(data.ok){
        msgDiv.innerText=`✔️ 已送出：${data.title}`;
        document.getElementById("urlInput").value="";
        updateQueue();
      } else {
        msgDiv.innerText=`❌ ${data.error}`;
      }
    })
    .catch(err=>{ msgDiv.innerText=`❌ 傳送失敗: ${err.message}`; });
}

function updateQueue(){
  fetch("/queue").then(res=>res.json()).then(data=>{
    const ul=document.getElementById("queueList"); ul.innerHTML="";
    data.forEach((item,index)=>{ ul.innerHTML+=`<li>${index+1}. ${item.title}</li>`; });
  });
}

updateQueue();
setInterval(updateQueue,5000);
